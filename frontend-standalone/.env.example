# 高德 JS API 浏览器端 Key（前端地图使用）。
# 该 Key 会出现在浏览器请求中，属于 JS Key 的正常使用形态；
# 请在高德控制台为它配置域名白名单（localhost 与线上 Vercel 域名）。
# 未填写时地图自动使用内置手绘路线预览，不影响其他功能。
NEXT_PUBLIC_AMAP_JS_KEY=

# 注意：高德安全密钥（securityJsCode）不再放在前端。
# 它只配置在后端环境变量 AMAP_SECURITY_JS_CODE，由后端 /amap-security/jscode 代理。
#
# BACKEND_URL 仅在生产环境（Vercel）配置，指向 Railway 后端地址；
# 本地开发留空即可，next.config.ts 默认转发到 http://localhost:8000。
