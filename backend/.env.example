ZHIPU_API_KEY=replace-with-your-server-side-key
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
ZHIPU_MODEL=glm-4-plus
DATABASE_PATH=data/travel.db
AMAP_API_KEY=
# 兼容已有配置名；两者任选其一，优先使用 AMAP_API_KEY。
AMAP_WEB_SERVICE_KEY=
# 高德 JS API 安全密钥：仅用于服务端 /_AMapService 通用代理（注入 jscode），严禁放入前端或 NEXT_PUBLIC_ 变量。
AMAP_SECURITY_JS_CODE=
AMAP_BASE_URL=https://restapi.amap.com/v3
AMAP_POI_BASE_URL=https://restapi.amap.com/v5
AMAP_CONNECT_TIMEOUT_SECONDS=10
AMAP_READ_TIMEOUT_SECONDS=20
AMAP_CACHE_TTL_SECONDS=2592000
AMAP_ROUTE_CACHE_TTL_SECONDS=604800
AMAP_ROUTE_FALLBACK_ENABLED=1
# Google Places 仅用于独立 enrichment PoC；当前尚未接入生产 pipeline。
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACES_BASE_URL=https://places.googleapis.com/v1
GOOGLE_PLACES_CONNECT_TIMEOUT_SECONDS=10
GOOGLE_PLACES_READ_TIMEOUT_SECONDS=25
GOOGLE_PLACES_CACHE_TTL_SECONDS=2592000
ENABLE_GOOGLE_PLACES=false
ENABLE_GOOGLE_OFFICIAL_FALLBACK=false
SERPER_API_KEY=
SERPER_BASE_URL=https://google.serper.dev
SERPER_TIMEOUT_SECONDS=12
SERPER_MAX_RESULTS=5
SERPER_CACHE_TTL_SECONDS=2592000
OFFICIAL_SOURCE_PROVIDER=serper
OFFICIAL_SOURCE_CACHE_TTL_SECONDS=7776000
# 官网事实解析：仅绑定人工核验注册表或未来经审核的数据源候选。
OFFICIAL_FACTS_ENABLED=1
OFFICIAL_FACTS_CONCURRENCY=3
OFFICIAL_PAGE_CACHE_TTL_SECONDS=86400
OFFICIAL_PAGE_ERROR_CACHE_TTL_SECONDS=600
OFFICIAL_PAGE_CONNECT_TIMEOUT_SECONDS=10
OFFICIAL_PAGE_READ_TIMEOUT_SECONDS=20
OFFICIAL_PAGE_WRITE_TIMEOUT_SECONDS=10
OFFICIAL_PAGE_POOL_TIMEOUT_SECONDS=10
OFFICIAL_PAGE_MAX_BYTES=2097152
TASK_SAFETY_TIMEOUT_SECONDS=1800
PACK_TIMEOUT_PLACES_SECONDS=210
PACK_TIMEOUT_ITINERARY_PLAN_SECONDS=210
PACK_TIMEOUT_ITINERARY_DAY_SECONDS=210
PACK_TIMEOUT_PRACTICAL_SECONDS=210
PACK_TIMEOUT_LANGUAGE_SECONDS=210
LLM_CONNECT_TIMEOUT_SECONDS=15
LLM_READ_TIMEOUT_SECONDS=100
LLM_WRITE_TIMEOUT_SECONDS=30
LLM_POOL_TIMEOUT_SECONDS=15
MAX_PROVIDER_RETRIES=1
PROVIDER_RETRY_BACKOFF_MIN_SECONDS=1
PROVIDER_RETRY_BACKOFF_MAX_SECONDS=3
ZHIPU_MODEL_VERSION=
ENABLE_DEV_MODES=0
LOG_LEVEL=INFO
WORKER_LEASE_SECONDS=45
