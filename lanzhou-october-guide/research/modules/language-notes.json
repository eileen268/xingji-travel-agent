  "travel_notes": {
    "_draft": false,
    "_review_required": "已按兰州10月路线复核。",
    "groups": [
      {
        "category": "climate",
        "title": "天气与穿着",
        "summary": "10月兰州昼夜温差和河边风感都明显，按可增减的三层穿法准备，并每天依据风力调整山地与河岸时段。",
        "items": [{"title":"早晚加防风层","note":"10月清晨、日落后和黄河岸边体感会明显转凉。把轻薄羽绒或防风外套放在随身包里，热时脱下而不是只穿一件厚衣。"},{"title":"干燥比低温更持久","note":"室外风和室内暖气都可能让皮肤、嘴唇与鼻腔干燥。每天分次喝水并补涂润唇膏，敏感者在住宿处使用加湿器。"},{"title":"日照强也要防晒","note":"气温偏低并不代表紫外线和河面反光弱。白天使用防晒霜、帽子和太阳镜，登白塔山时尤其不要省略。"},{"title":"用室内馆应对坏天气","note":"降雨、大风或明显降温会削弱河岸和山顶体验。把甘肃省博物馆或简牍博物馆作为替代，但先确认预约和周一闭馆。"}]
      },
      {
        "category": "etiquette",
        "title": "文化与礼仪",
        "summary": "兰州的清真餐饮和寺观空间都有清楚的行为边界，先观察当地人和现场标识，再拍照、点餐或进入院落。",
        "items": [{"title":"尊重清真餐饮习惯","note":"不少牛肉面与羊肉餐厅明确标示清真。不要携带含猪肉或酒类的外食进入，是否售酒或能否自带饮品直接询问店员。"},{"title":"寺观先看再举机","note":"白塔寺、五泉山院落和白云观可能有真实宗教活动。看到礼拜、法事或禁拍标识时收起相机，建筑摄影也不要挡住香客动线。"},{"title":"清真寺以礼拜为先","note":"如临时进入清真寺周边，应穿着得体并避免礼拜时间喧哗。内部是否接待游客、能否拍照以现场管理人员说明为准。"},{"title":"老城市场谨慎买古玩","note":"城隍庙一带兼有古玩与民俗商业，年代和真伪不容易现场判断。普通旅行者以观看和小额纪念品为主，高价物品必须有凭证与清楚来源。"}]
      },
      {
        "category": "transport",
        "title": "当地交通",
        "summary": "兰州城市景点多沿黄河东西展开，地铁、出租车与步行组合效率最高；机场距离市区远，返程必须单独留缓冲。",
        "items": [{"title":"河岸路线按同侧串联","note":"黄河两岸桥梁间距会放大看似很近的直线距离。一天尽量在同侧顺行，跨河只选中山桥或明确的交通节点，避免反复折返。"},{"title":"地铁负责长段移动","note":"张掖路、东方红广场与西站方向可先用地铁完成主干移动。最后一两公里再步行或打车，既节省体力也降低堵车影响。"},{"title":"打车出示完整中文名","note":"同名店、分店和南北滨河路容易造成误解。上车前把门店分店名、道路和地图定位一并出示，抵达前核对招牌。"},{"title":"中川机场单独反推时间","note":"兰州中川机场位于市区以北且距离较远，交通时间受班次和路况影响。拿到航班后从起飞时间倒推，至少预留三小时离开市区。"}]
      },
      {
        "category": "safety",
        "title": "安全与应急",
        "summary": "主要景点整体适合普通游客，但山路、水边、夜市拥挤与干燥不适需要具体止损线；把缩短行程写进每天计划。",
        "items": [{"title":"山路以下行为替代","note":"白塔山和五泉山都有台阶与坡道，雨后或落叶季可能打滑。膝盖不适就只走低处院落，白塔山可视运营情况用索道减少爬升。"},{"title":"黄河边不越护栏","note":"黄河流速、水位与岸边高差不适合靠近试探。拍照始终留在护栏和开放步道内，游船停航时不寻找私人船只替代。"},{"title":"夜市管好随身物品","note":"正宁路和节假日老城夜间会拥挤，热锅与车辆也增加碰撞风险。手机用腕带或拉链包收好，拍照时站到摊位侧边而非通道中央。"},{"title":"肠胃不适立即减量","note":"辣油、羊肉、甜醅和夜市甜食连续叠加容易让肠胃负担过重。两人分食、少辣并补充清淡热水，出现持续不适就取消下一餐挑战。"}]
      },
      {
        "category": "payment",
        "title": "支付与现金",
        "summary": "移动支付覆盖广，但小摊、信号和手机电量仍可能造成短时失败；两人准备主副支付方式与少量现金即可。",
        "items": [{"title":"主用扫码并留备用卡","note":"餐厅、商场与多数小摊普遍可用微信或支付宝。两个人分别绑定可用银行卡，避免一部手机没电后两人都无法付款。"},{"title":"少量现金处理小额异常","note":"老摊位、临时设备故障或网络不稳时可能更适合现金。准备少量小面额纸币并分开保管，不需要携带大量现金。"},{"title":"先确认价格和分量","note":"手抓羊肉可能按斤或按份，小吃也有大小份区别。下单前复述分量与价格，扫码后立即检查金额，发现错误当场沟通。"},{"title":"贵价工艺品保留凭证","note":"刻葫芦、仿古物和陶瓷价格差异大，作者与工艺也影响价值。高价购买要求收据、作者或店铺信息和包装说明，无法说明来源就放弃。"}]
      }
    ]
  }
}
